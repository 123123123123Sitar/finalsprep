# =============================================================================
# FinalsPrep environment variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ----- Site -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Anthropic (required for /chat and arbitrary /explain calls) -----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=

# ----- Firebase client SDK (auth + Firestore read/write from browser) -----
# Firebase console → Project settings → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----- Firebase Admin SDK (server-side, required for auth enforcement + capture) -----
# Base64-encoded service account JSON.
# To generate: Firebase console → Project settings → Service accounts →
# "Generate new private key" → download the .json → run:
#   cat /path/to/key.json | base64 | tr -d '\n'
# and paste the result below. Never commit this file.
FIREBASE_ADMIN_KEY_B64=

# ----- PayPal (required for paid plans + token packs) -----
# One-time Orders API. Works with PayPal Personal and Business accounts.
# Dashboard: https://developer.paypal.com/dashboard/applications/sandbox
# Apps & Credentials → Create App → copy Client ID + reveal Secret.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal webhook ID (optional, set after first deploy):
#   Dashboard → your app → Sandbox Webhooks → Add Webhook →
#   URL: https://yourdomain.com/api/webhooks/paypal →
#   Events: PAYMENT.CAPTURE.COMPLETED → copy the Webhook ID here.
PAYPAL_WEBHOOK_ID=

# ----- Optional: Resend for email capture (resend.com) -----
RESEND_API_KEY=
CAPTURE_TO_EMAIL=
