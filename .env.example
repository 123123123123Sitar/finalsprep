# =============================================================================
# FinalsPrep environment variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ----- Site -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Anthropic (required for /chat and arbitrary /explain calls) -----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ----- Firebase client SDK (auth + Firestore read/write from browser) -----
# Firebase console → Project settings → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----- Firebase Admin SDK (server-side, required for auth enforcement + webhook) -----
# Base64-encoded service account JSON.
# To generate: Firebase console → Project settings → Service accounts →
# "Generate new private key" → download the .json → run:
#   cat /path/to/key.json | base64 | tr -d '\n'
# and paste the result below. Never commit this file.
FIREBASE_ADMIN_KEY_B64=

# ----- Stripe (required for subscriptions) -----
# Test mode: https://dashboard.stripe.com/test/apikeys
# Existing Regular pricing can use the legacy STRIPE_PRICE_MONTHLY /
# STRIPE_PRICE_YEARLY names. Pro is optional and uses the dedicated vars below.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_REGULAR_MONTHLY=price_...
STRIPE_PRICE_REGULAR_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_MONTHLY=price_...   # legacy alias for Regular monthly
STRIPE_PRICE_YEARLY=price_...    # legacy alias for Regular yearly

# Stripe webhook signing secret for /api/webhooks/stripe
# Local dev: run  stripe listen --forward-to localhost:3000/api/webhooks/stripe
# and copy the whsec_... value it prints.
# Production: dashboard → Developers → Webhooks → Add endpoint → copy the secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# ----- Optional: Resend for email capture (resend.com) -----
RESEND_API_KEY=
CAPTURE_TO_EMAIL=
