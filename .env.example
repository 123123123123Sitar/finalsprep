# =============================================================================
# FinalsPrep environment variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ----- Site -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Anthropic (required for /chat and arbitrary /explain calls) -----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=

# ----- Inception Labs Mercury 2 (default model for the free/learner tier) -----
# https://platform.inceptionlabs.ai/
# When set, learner-tier text chat uses Mercury 2 first; falls back to
# Gemini, then Claude Haiku, on failure. Image queries always go to Gemini.
INCEPTION_API_KEY=

# ----- Firebase client SDK (auth + Firestore read/write from browser) -----
# Firebase console → Project settings → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----- Firebase Admin SDK (server-side, required for auth enforcement + capture) -----
# Base64-encoded service account JSON.
# To generate: Firebase console → Project settings → Service accounts →
# "Generate new private key" → download the .json → run:
#   cat /path/to/key.json | base64 | tr -d '\n'
# and paste the result below. Never commit this file.
FIREBASE_ADMIN_KEY_B64=

# ----- Firebase Storage (required for avatar uploads) -----
# Usually the same as NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET; set explicitly
# on the server so the admin SDK knows where to write avatars.
FIREBASE_STORAGE_BUCKET=

# ----- Ko-fi (required for paid plans + token packs + gifts) -----
# Ko-fi routes payments directly to your connected PayPal Personal /
# Stripe account. We only need their webhook to grant access.
# Setup: https://ko-fi.com/manage/webhooks → copy the verification token.
KOFI_VERIFICATION_TOKEN=

# Map each Ko-fi Shop product's direct-link code (from ko-fi.com/s/<code>)
# to our internal SKU. Create the products in your Ko-fi Shop, then
# paste the 10-char code from each product URL here.
KOFI_CODE_PRO_MONTHLY=
KOFI_CODE_PRO_SIXMONTH=
KOFI_CODE_HACKER_MONTHLY=
KOFI_CODE_HACKER_SIXMONTH=
KOFI_CODE_PACK_SMALL=
KOFI_CODE_PACK_MEDIUM=
KOFI_CODE_PACK_LARGE=
# Gift SKUs — buyer receives a redemption code + bonus tokens.
KOFI_CODE_GIFT_PRO_MONTHLY=
KOFI_CODE_GIFT_PRO_SIXMONTH=
KOFI_CODE_GIFT_HACKER_MONTHLY=
KOFI_CODE_GIFT_HACKER_SIXMONTH=

# ----- Resend (lead-magnet capture only) -----
# https://resend.com → API keys. Used by /api/capture to deliver the free
# formula-sheet to subscribers. The contact form uses SMTP (below) instead.
RESEND_API_KEY=
CAPTURE_TO_EMAIL=

# ----- SMTP / nodemailer (contact form delivery) -----
# /api/contact uses nodemailer so messages land in any mailbox you own
# without needing a Resend-verified domain.
#
# Gmail setup (recommended for finalsprephelp@gmail.com):
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password (Mail, "Other: FinalsPrep"):
#      https://myaccount.google.com/apppasswords
#   3. Paste the 16-char password (no spaces) into SMTP_PASS.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=finalsprephelp@gmail.com
#   SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where contact-form submissions land. Defaults to finalsprephelp@gmail.com.
CONTACT_TO_EMAIL=
# Defaults to `FinalsPrep <$SMTP_USER>` so SPF/DKIM line up automatically.
# Only override if you want a different display name or verified alias.
CONTACT_FROM_EMAIL=
