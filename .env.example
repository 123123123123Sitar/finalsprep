# =============================================================================
# FinalsPrep environment variables
# Copy this file to .env.local and fill in the values.
# =============================================================================

# ----- Site -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Anthropic (required for /chat and arbitrary /explain calls) -----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=

# ----- Firebase client SDK (auth + Firestore read/write from browser) -----
# Firebase console → Project settings → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----- Firebase Admin SDK (server-side, required for auth enforcement + capture) -----
# Base64-encoded service account JSON.
# To generate: Firebase console → Project settings → Service accounts →
# "Generate new private key" → download the .json → run:
#   cat /path/to/key.json | base64 | tr -d '\n'
# and paste the result below. Never commit this file.
FIREBASE_ADMIN_KEY_B64=

# ----- Ko-fi (required for paid plans + token packs) -----
# Ko-fi routes payments directly to your connected PayPal Personal /
# Stripe account. We only need their webhook to grant access.
# Setup: https://ko-fi.com/manage/webhooks → copy the verification token.
KOFI_VERIFICATION_TOKEN=

# Map each Ko-fi Shop product's direct-link code (from ko-fi.com/s/<code>)
# to our internal SKU. Create the products in your Ko-fi Shop, then
# paste the 10-char code from each product URL here.
KOFI_CODE_PRO_MONTHLY=
KOFI_CODE_PRO_SIXMONTH=
KOFI_CODE_HACKER_MONTHLY=
KOFI_CODE_HACKER_SIXMONTH=
KOFI_CODE_PACK_SMALL=
KOFI_CODE_PACK_MEDIUM=
KOFI_CODE_PACK_LARGE=

# ----- Optional: Resend for email capture (resend.com) -----
RESEND_API_KEY=
CAPTURE_TO_EMAIL=
