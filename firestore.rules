rules_version = '2';

// FinalsPrep security rules.
//
// Principle of least privilege:
//   - Users can read their own data under users/{uid}/...
//   - Users can write their own *non-billing* subtree (chat history,
//     lesson progress, etc.)
//   - Billing is READ-ONLY for the user. The Stripe webhook uses the
//     Admin SDK, which bypasses these rules, so plan promotion only ever
//     happens server-side after a verified Stripe event.
//
// This prevents a signed-in user from opening the browser console and
// writing { plan: "pro" } into their own billing doc.
service cloud.firestore {
  match /databases/{database}/documents {
    // Billing: read-only for owner, client writes denied.
    match /users/{uid}/profile/billing {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else under users/{uid}: owner read/write.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
